# 부팅 뒤 자동으로 주행 녹화를 시작하는 systemd 사용자 서비스.
# 설치와 켜고 끄기는 docs/vehicle_power_and_autostart.md 를 본다.
# 경로는 저장소가 ~/work/fsd_diff_npu, 가상환경이 그 안의 .venv 라고 가정한다(%h 는 홈 폴더).

[Unit]
Description=FSD reality view drive recorder (cameras only, no NPU)
# 카메라를 같이 잡으므로 데모 서비스와 동시에 돌지 않게 한다
Conflicts=fsd-demo.service
# 너무 자주 죽으면 멈춘다(10분 동안 5번)
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/work/fsd_diff_npu
Environment=PYTHONUNBUFFERED=1
# 부팅 직후 카메라 드라이버가 준비될 시간을 준다
ExecStartPre=/bin/sleep 5
# --stop-file: 이 파일이 생기면 녹화를 닫고 끝냄(시험용). 시작할 때 남아 있던 파일은 지운다
# --acc-gpio: ACC 배선을 마친 뒤에만 아래 줄 끝에 --acc-gpio 17 을 더한다(핀은 문서 4장, 확인 필요)
ExecStart=%h/work/fsd_diff_npu/.venv/bin/python3 scripts/record_drive.py --config configs/two_cam_current.yaml --segment 60 --thermal --stop-file out/STOP_RECORD
# systemd 는 SIGTERM 을 보낸다. 녹화 도구는 이것을 받아 세그먼트를 닫고 os.sync 한 뒤 끝낸다
KillSignal=SIGTERM
# 카메라 스레드 join(최대 10초) + fsync 를 기다린다. 넘기면 SIGKILL 이라 넉넉히 둔다
TimeoutStopSec=40
Restart=on-failure
RestartSec=15
# 과열로 스스로 끝낸 경우(종료 코드 75)에는 다시 띄우지 않는다
RestartPreventExitStatus=75

[Install]
WantedBy=default.target
