# 부팅 뒤 자동으로 리얼리티 뷰 데모(Hailo-8 검출 + 3D 화면)를 시작하는 systemd 사용자 서비스.
# 설치와 켜고 끄기는 docs/vehicle_power_and_autostart.md 를 본다.
# 화면 창을 띄우므로 데스크톱 자동 로그인이 필요하다. 화면 없이 돌릴 때는 --headless 를 더한다.

[Unit]
Description=FSD reality view demo (Hailo-8 detection, thermal guard)
Conflicts=fsd-record.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/work/fsd_diff_npu
Environment=PYTHONUNBUFFERED=1
# 파이 OS 데스크톱(Wayland) 기본값. 다르면 바꾼다(확인 필요)
Environment=WAYLAND_DISPLAY=wayland-0 DISPLAY=:0 XDG_RUNTIME_DIR=/run/user/%U
ExecStartPre=/bin/sleep 10
# 방열판이 없는 동안의 안전장치: --thermal(단계별 부하 낮춤, 위험이면 종료 코드 75로 끝냄)과
# --hailo-stop-temp 95(건강 기록 때 Hailo-8 95도 이상이면 끝냄)를 같이 건다
ExecStart=%h/work/fsd_diff_npu/.venv/bin/python3 scripts/run_demo.py --config configs/two_cam_current.yaml --backend hailo --view 3d --thermal --thermal-csv out/service/demo_thermal.csv --health-csv out/service/demo_health.csv --health-interval 10 --hailo-stop-temp 95 --stop-file out/STOP_DEMO
# run_demo.py 는 SIGINT(KeyboardInterrupt)를 받아 장치를 놓고 끝낸다. SIGTERM 대신 SIGINT 를 보낸다
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=75

[Install]
WantedBy=default.target
